# Copy to dev-proxy/session.env (gitignored — it holds a live credential).
# Capture after logging in once via pane A:
#   DevTools > Application > Cookies > http://localhost:3000 > appSession value
# Recapture when the session expires (you land on the Auth0 login page again).

# Cookie name used by your Auth0 SDK (nextjs-auth0 default: appSession)
SESSION_COOKIE_NAME=appSession

# The cookie VALUE only (no "appSession=" prefix)
APP_SESSION=
