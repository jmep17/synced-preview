{
  "name": "synced-preview-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -n vite,fixtures \"pnpm --filter app dev\" \"node fixtures/demo-server.mjs\"",
    "dev:app": "pnpm --filter app dev",
    "dev:fixtures": "node fixtures/demo-server.mjs",
    "build": "pnpm --filter app build",
    "preview": "pnpm --filter app preview",
    "test": "node --test tools/mock-proxy/mock-proxy.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
